---
import { identity } from '../data/portfolio.mjs';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const navigation = [ ['/', 'Home'], ['/about/', 'About'], ['/projects/', 'Projects'], ['/articles/', 'Articles'] ];
function current(href: string) {
  if (pathname === href) return 'page';
  if (href !== '/' && pathname.startsWith(href)) return 'location';
  return undefined;
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Portfolio</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="identity" href="/">{identity.handle}</a>
      <nav aria-label="Primary"><ul>{navigation.map(([href, label]) => <li><a href={href} aria-current={current(href)}>{label}</a></li>)}</ul></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer aria-label="Contact">
      <a href="mailto:haro.j.angel@gmail.com">haro.j.angel@gmail.com</a>
      <a href="https://github.com/aharoj">GitHub (aharoJ)</a>
    </footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; font-family: Georgia, 'Times New Roman', serif; color: #272a29; background: #faf9f5; line-height: 1.7; }
  * { box-sizing: border-box; }
  body { max-width: 46rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
  header, footer, .eyebrow { font-family: system-ui, sans-serif; }
  header { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: baseline; margin-bottom: 3rem; }
  .identity { font-weight: 650; }
  nav ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; list-style: none; padding: 0; margin: 0; }
  nav a[aria-current] { font-weight: 650; text-decoration-thickness: 2px; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.15; font-weight: 400; }
  h2 { font-size: 1.5rem; line-height: 1.3; margin-top: 2rem; }
  p { margin: 1.25rem 0; }
  a { color: #245d4b; text-underline-offset: .2em; overflow-wrap: anywhere; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .eyebrow { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  footer { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid #d7dad4; font-size: .875rem; }
  .skip { position: absolute; left: 1rem; top: .25rem; transform: translateY(-200%); }
  .skip:focus { transform: none; }
  img { display: block; max-width: 100%; height: auto; }
</style>
