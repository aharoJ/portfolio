---
import Page from '../layouts/Page.astro';
import { projects } from '../data/portfolio.mjs';
const categories = [...new Set(projects.map(project => project.category))];
---
<Page title="Projects" description="Projects by Angel Jair Haro, grouped by category.">
  <h1>Projects</h1>
  {categories.map(category => <section aria-label={category}>
    <h2>{category}</h2>
    <ul>{projects.filter(project => project.category === category).map(project => <li><a href={project.href}>{project.title}</a></li>)}</ul>
  </section>)}
</Page>
