---
import Page from '../layouts/Page.astro';
import { identity, skills } from '../data/portfolio.mjs';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
---
<Page title="About" description="About Angel Jair Haro, Software Engineer, and skills.">
  <p class="eyebrow">About</p>
  <h1>{identity.name}</h1>
  <p>{identity.role} · {identity.handle}</p>
  <Image src={portrait} width={240} height={320} format="webp" quality={80} alt="" />
  <h2>Skills</h2>
  <ul>{skills.map(skill => <li>{skill}</li>)}</ul>
</Page>
